# Copy to .env and fill in your own credentials. This file contains no live keys.
# Generate URL-safe passwords/secrets with: openssl rand -hex 24

# PostgreSQL: container address and host-published connection
POSTGRES_USER=marmot
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=marmot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/${POSTGRES_DB}

# Demo source data (set before the first database initialization)
HISTORY_DAYS=30
SIMULATOR_MAX_ORDERS=100

# Marmot: generate a 32-byte base64 key with: openssl rand -base64 32
# Keep that encryption key when reusing a database with stored credentials.
MARMOT_HOST_PORT=8085
MARMOT_HOST=http://localhost:${MARMOT_HOST_PORT}
MARMOT_ENCRYPTION_KEY=
# Create this in your own Marmot instance after its first startup.
MARMOT_API_KEY=

# Dagu and dbt
DAGU_HOST_PORT=8088
DBT_THREADS=1
DBT_PROFILES_DIR=analytics
DBT_ALLOW_EXPERIMENTAL_ADAPTERS=true

# Cube connects to the same PostgreSQL server as role cube_core.
CUBEJS_HOST_PORT=4000
CUBEJS_API_SECRET=replace_with_random_cube_secret
CUBEJS_DEV_MODE=true
CUBEJS_DB_USER=cube_core
CUBEJS_DB_PASS=replace_with_cube_database_password
# Optional REST token when using authenticated Cube API mode.
CUBE_API_TOKEN=
CUBEJS_PG_SQL_PORT=15432
CUBEJS_SQL_USER=cube
CUBEJS_SQL_PASSWORD=replace_with_cube_sql_password

# DBHub SQL endpoint over Cube
DBHUB_HOST_PORT=8086
DBHUB_CUBE_HOST=cube_api
DBHUB_CUBE_DATABASE=db
DBHUB_ALLOWED_HOSTS=localhost,127.0.0.1,dbhub

# Assistant and MCP endpoints
MCP_SERVER_HOST_PORT=8001
ASSISTANT_UI_HOST_PORT=3000
BAKERY_AGENT_HOST_PORT=8123
OPENAI_API_KEY=
BAKERY_AGENT_MODEL=replace_with_your_model_name
BAKERY_AGENT_REASONING_EFFORT=low
